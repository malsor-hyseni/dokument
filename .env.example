# =============================================================================
# DOKUMENT — Variablat e ambientit
# =============================================================================
# Kopjoje këtë skedar si `.env` (lokalisht) ose vendosi këto vlera te
# Vercel → Project → Settings → Environment Variables.
#
# Të dyja vlerat merren nga:
#   Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# URL-ja e projektit tuaj Supabase
# Shembull: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Çelësi PUBLIK `anon` (publishable). Ky çelës është i sigurt për frontend,
# sepse çdo qasje në të dhëna mbrohet nga Row Level Security (RLS).
SUPABASE_ANON_KEY=

# =============================================================================
# PARALAJMËRIM SIGURIE
# =============================================================================
# MOS e vendosni KURRË `service_role` key në këtë projekt, në Vercel, në kod,
# apo kudo që arrin te shfletuesi. Ai çelës anashkalon plotësisht RLS-në dhe
# jep qasje të pakufizuar në të gjitha të dhënat e të gjithë përdoruesve.
# DOKUMENT nuk e përdor dhe nuk ka nevojë për të.
# =============================================================================
